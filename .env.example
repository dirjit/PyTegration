# =============================================================================
# .env.example — documented template for local configuration
# =============================================================================
# LESSON: Module 6 (Config & Secrets). See docs/06-config-and-secrets.md
# Copy to `.env` (gitignored) and adjust:  cp .env.example .env
# Every value below is a SAFE placeholder for local development.
# =============================================================================

APP_ENV=development

# Shared secret for protected endpoints (send as the `X-API-Key` header).
# In the Cosmic Explorer web page this is the "Explorer Pass" for the Space Guide.
API_KEY=dev-local

# LLM backend: `mock` runs fully offline; `claude` needs ANTHROPIC_API_KEY.
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AGENT_MAX_ITERATIONS=6

RATE_LIMIT_CAPACITY=60
RATE_LIMIT_WINDOW_SECONDS=60

DATABASE_URL=sqlite+aiosqlite:///./pytegration.db
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
